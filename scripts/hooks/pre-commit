#!/usr/bin/env bash
# main/ 은 관리 대상 리포의 clone 이라 이 리포에 커밋하지 않는다.
set -euo pipefail

staged=$(git diff --cached --name-only | grep -E '^main/' || true)

if [[ -n "$staged" ]]; then
    echo "error: main/ 디렉토리는 커밋할 수 없습니다." >&2
    echo "" >&2
    echo "  git reset HEAD main/" >&2
    echo "" >&2
    echo "위 명령어로 staging에서 제거해주세요." >&2
    exit 1
fi
