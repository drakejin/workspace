{
  "name": "meta-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "MEMORY_E2E=1 vitest run --dir test/e2e",
    "mcp": "pnpm --filter @meta/memory-mcp start",
    "memory": "pnpm --filter @meta/memory-mcp cli",
    "daemon": "pnpm --filter @meta/daemon start",
    "reconcile": "pnpm --filter @meta/daemon once"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
