# OpenSearch (docker-compose.yml 기본값)
OPENSEARCH_URL=http://localhost:9202
# meta-repository 루트. 비우면 현재 작업 디렉토리
META_REPO_ROOT=
# frontmatter에 team이 없을 때 쓰는 팀
MEMORY_DEFAULT_TEAM=default
# hot/cold 경계 (일)
MEMORY_HOT_DAYS=60
# cold 스냅샷 repository: fs(기본, docker-compose의 ./.data/snapshots) 또는 s3
COLD_SNAPSHOT_REPOSITORY=mem-cold
COLD_SNAPSHOT_TYPE=fs
COLD_SNAPSHOT_FS_LOCATION=/usr/share/opensearch/snapshots
COLD_SNAPSHOT_S3_BUCKET=
# raw 원본 + 청크 JSONL 보관소: 비우면 ./.data/cold-store, 값이 있으면 S3
COLD_STORE_DIR=
COLD_STORE_S3_BUCKET=
COLD_STORE_S3_PREFIX=memory
AWS_REGION=ap-northeast-2
