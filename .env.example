# 메모리 층 설정. 비우면 기본값. 명령줄에서 준 값(META_REPO_ROOT=... make ...)이 이 파일보다 우선한다.

# ── 기본 ───────────────────────────────────────────────
# OpenSearch (docker-compose.yml 기본 포트 9202)
OPENSEARCH_URL=http://localhost:9202
# meta-repository 루트. 비우면 이 레포
META_REPO_ROOT=
# meta-repository 이름 — 같은 OpenSearch 를 여러 meta-repo 가 써도 섞이지 않게 하는 격리 축. 비우면 루트 디렉토리 이름
MEMORY_WORKSPACE=
# frontmatter 에 team 이 없을 때 쓰는 팀/실 (인덱스 mem-{team}-...)
MEMORY_DEFAULT_TEAM=default
# hot/cold 경계 (일)
MEMORY_HOT_DAYS=60

# ── 데몬 ───────────────────────────────────────────────
MEMORY_RECONCILE_INTERVAL_SECONDS=60
MEMORY_RECONCILE_DEBOUNCE_MS=3000
MEMORY_MAX_FILE_BYTES=2097152
MEMORY_SANITY_MAX_FILES=5000
# 판정: 유효 시각 차가 이보다 크면 latest-wins, 작으면 로컬 claude 가 판정
MEMORY_JUDGE_ENABLED=true
MEMORY_JUDGE_WINDOW_DAYS=7
# more_like_this 점수 / 자기 자신 점수 (0~1)
MEMORY_JUDGE_MIN_SCORE=0.3
# 증류: 문서 본문이 LLM 으로 간다. 기밀 범위를 정한 뒤 켠다
MEMORY_DISTILL_ENABLED=false
MEMORY_DISTILL_CONCURRENCY=2
# 판정·증류 LLM = 로컬 Claude Code CLI (API 키 없음)
MEMORY_CLAUDE_BIN=claude
MEMORY_LLM_MODEL=opus
MEMORY_LLM_TIMEOUT_MS=120000

# ── cold ───────────────────────────────────────────────
# 스냅샷 repository: fs(기본, ./.data/snapshots) 또는 s3 (OpenSearch 에 repository-s3 플러그인 필요)
COLD_SNAPSHOT_REPOSITORY=mem-cold
COLD_SNAPSHOT_TYPE=fs
COLD_SNAPSHOT_FS_LOCATION=/usr/share/opensearch/snapshots
COLD_SNAPSHOT_S3_BUCKET=
# raw 원본 + 청크 JSONL 보관소: 비우면 ./.data/cold-store, 버킷을 주면 S3 ({prefix}/{workspace}/)
COLD_STORE_DIR=
COLD_STORE_S3_BUCKET=
COLD_STORE_S3_PREFIX=memory
AWS_REGION=ap-northeast-2
