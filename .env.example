# 메모리 층 설정. cp .env.example .env 후 필요한 것만 바꾼다. 비우면 기본값.
# 명령줄에서 준 값(META_REPO_ROOT=... scripts/memory-daemon/run.sh once)이 이 파일보다 우선한다. docker compose 도 이 파일을 읽는다 (포트).

# ── 스택 포트 (docker-compose.yml) ─────────────────────────
# 같은 머신의 다른 메모리 스택(9200/9201, 7687/7688)과 겹치지 않게 잡은 기본값
OS_PORT=9202
NEO4J_BOLT_PORT=7689
NEO4J_HTTP_PORT=7476
OS_DASH_PORT=5603

# ── 기본 ───────────────────────────────────────────────
# 비우면 OS_PORT 로 만든다 (http://localhost:9202)
OPENSEARCH_URL=
# 색인할 meta-repository 루트. 비우면 이 레포
META_REPO_ROOT=
# meta-repository 이름 — 같은 OpenSearch·Neo4j 를 여러 meta-repo 가 써도 섞이지 않게 하는 격리 축. 비우면 루트 디렉토리 이름
MEMORY_WORKSPACE=
# frontmatter 에 team 이 없을 때 쓰는 팀 (인덱스 mem-{team}-...). 팀 하나는 workspace 하나에만 속한다
MEMORY_DEFAULT_TEAM=default
# org("실") alias: "팀=org,팀=org" — 같은 org 의 팀들을 mem-org-{org}-hot 하나로 함께 검색 (search_memory org=)
MEMORY_TEAM_ORGS=
# hot/cold 경계 (일). scripts/memory/run.sh tier 는 바로 따르고, ISM 은 새로 만드는 인덱스부터 (이미 정책이 붙은 인덱스는 처음 기간 유지)
MEMORY_HOT_DAYS=60
# 문서의 날(날짜 필터의 하루)을 정하는 IANA 시간대 (예: Asia/Seoul). 비우면 이 머신의 시간대. frontmatter date 는 적힌 날 그대로다
MEMORY_TIME_ZONE=

# ── 데몬 ───────────────────────────────────────────────
MEMORY_RECONCILE_INTERVAL_SECONDS=60
MEMORY_RECONCILE_DEBOUNCE_MS=3000
# 이보다 큰 파일은 색인하지 않는다 (데몬·ingest_path 모두). 이미 색인된 문서가 커지면 데몬이 색인에서 뺀다
MEMORY_MAX_FILE_BYTES=2097152
# 색인 대상이 이보다 많으면 설정 오류로 보고 거부한다 (루트를 잘못 잡았을 때의 보호)
MEMORY_SANITY_MAX_FILES=5000
# 판정: 유효 시각 차가 WINDOW 보다 크면 latest-wins, 이내면 로컬 claude 가 판정, 확신이 낮으면 질문
MEMORY_JUDGE_ENABLED=true
MEMORY_JUDGE_WINDOW_DAYS=7
# 이웃 유사도 하한 (자기 자신 점수 대비 0~1)
MEMORY_JUDGE_MIN_SCORE=0.3
# 증류(요약·entity): 문서 본문이 LLM 으로 간다. 기밀 범위를 정한 뒤 켠다. entity 는 그래프의 Entity 노드가 된다
MEMORY_DISTILL_ENABLED=false
MEMORY_DISTILL_CONCURRENCY=2
# 판정·증류 LLM = 로컬 Claude Code CLI (API 키 없음 — 로그인만)
MEMORY_CLAUDE_BIN=claude
MEMORY_LLM_MODEL=opus
MEMORY_LLM_TIMEOUT_MS=120000

# ── knowledge graph (Neo4j) ─────────────────────────────
# 비우면 NEO4J_BOLT_PORT 로 만든다 (bolt://localhost:7689). off 면 그래프를 끈다 (색인·검색은 그대로)
MEMORY_GRAPH_URI=
# compose 의 Neo4j 는 NEO4J_AUTH=none — 인증을 켠 Neo4j 를 쓸 때만
MEMORY_GRAPH_USER=
MEMORY_GRAPH_PASSWORD=
MEMORY_GRAPH_DATABASE=neo4j

# ── cold ───────────────────────────────────────────────
# 스냅샷 repository: fs(기본 — 컨테이너 /usr/share/opensearch/snapshots = ./.cache/snapshots) 또는
# s3 (OpenSearch 에 repository-s3 플러그인 + keystore 자격 증명 필요 — app/test/s3/Dockerfile 참고)
COLD_SNAPSHOT_REPOSITORY=mem-cold
COLD_SNAPSHOT_TYPE=fs
COLD_SNAPSHOT_FS_LOCATION=/usr/share/opensearch/snapshots
COLD_SNAPSHOT_S3_BUCKET=
# raw 원본 + 청크 JSONL 보관소: 비우면 ./.cache/cold-store, 버킷을 주면 S3 (s3://{bucket}/{prefix}/{workspace}/)
# S3 여도 스냅샷 목록 쓰기 잠금 파일은 COLD_STORE_DIR/.locks 에 둔다
COLD_STORE_DIR=
COLD_STORE_S3_BUCKET=
COLD_STORE_S3_PREFIX=memory
AWS_REGION=ap-northeast-2
# S3 호환 저장소(LocalStack·MinIO 등)를 쓸 때만. 자격 증명은 AWS 기본 체인(AWS_PROFILE, AWS_ACCESS_KEY_ID ...)
AWS_ENDPOINT_URL_S3=
COLD_STORE_S3_PATH_STYLE=false
